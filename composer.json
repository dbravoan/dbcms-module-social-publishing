{
    "name": "dbravoan/dbcms-module-social-publishing",
    "type": "dbcms-module",
    "description": "Módulo SocialPublishing desacoplado para dbCMS",
    "license": "MIT",
    "require": {
        "dbravoan/dbcms-core": "^4.0",
        "dbravoan/dbcms-module-marketing": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "DbCms\\Modules\\SocialPublishing\\": "./"
        }
    },
    "extra": {
        "dbcms": {
            "identifier": "social-publishing",
            "name": "Publicaciones sociales",
            "description": "Módulo SocialPublishing desacoplado para dbCMS",
            "provider": "DbCms\\Modules\\SocialPublishing\\SocialPublishingModuleServiceProvider",
            "is_pageable": false,
            "widgets": {},
            "permissions": [
                "read:social-publishing",
                "manage:social-publishing",
                "approve:social-publishing",
                "manage:social-accounts"
            ],
            "repository": "https://github.com/dbravoan/dbcms-module-social-publishing"
        }
    }
}
